# Agent-Ready Environment Variables (Required for Phase 1.2+ LLM Probers)

# OpenAI API Key (for GPTBot & ChatGPT probes)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for ClaudeBot & Claude-Web probes)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (for Gemini & Google-Extended probes)
GEMINI_API_KEY=your_gemini_api_key_here

# Perplexity API Key (for Perplexity search probes)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
